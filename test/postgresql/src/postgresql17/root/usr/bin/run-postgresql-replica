export PG_PRIMARY_HOST=${PG_PRIMARY_HOST}
export PG_PRIMARY_PORT=${PG_PRIMARY_PORT:-5432}

if [ -z "${PG_PRIMARY_HOST}" ] ||
   [ -z "${PG_REPL_USER_NAME}" ] || [ -z "${PG_REPL_PASSWORD}" ]; then
    echo "PG_PRIMARY_HOST, PG_REPL_USER_NAME and PG_REPL_PASSWORD need to be defined."
    exit 1
fi

export PG_MAX_CONNECTIONS=${PG_MAX_CONNECTIONS:-100}
export PG_SHARED_BUFFERS=${PG_SHARED_BUFFERS:-256MB}
export PG_WORK_MEM=${PG_WORK_MEM:-4MB}
export PG_MAX_PARALLEL_WORKERS=${PG_MAX_PARALLEL_WORKERS:-8}
export PG_EFFECTIVE_CACHE_SIZE=${PG_EFFECTIVE_CACHE_SIZE:-4GB}
export PG_MAX_WAL_SIZE=${PG_MAX_WAL_SIZE:-1GB}
export PG_LOG_LEVEL=${PG_LOG_LEVEL:-debug5}


sed -i "s/PG_MAX_CONNECTIONS/$PG_MAX_CONNECTIONS/g" /conf/postgresql.conf
sed -i "s/PG_SHARED_BUFFERS/$PG_SHARED_BUFFERS/g" /conf/postgresql.conf
sed -i "s/PG_WORK_MEM/$PG_WORK_MEM/g" /conf/postgresql.conf
sed -i "s/PG_MAX_PARALLEL_WORKERS/$PG_MAX_PARALLEL_WORKERS/g" /conf/postgresql.conf
sed -i "s/PG_EFFECTIVE_CACHE_SIZE/$PG_EFFECTIVE_CACHE_SIZE/g" /conf/postgresql.conf
sed -i "s/PG_MAX_WAL_SIZE/$PG_MAX_WAL_SIZE/g" /conf/postgresql.conf
sed -i "s/PG_LOG_LEVEL/$PG_LOG_LEVEL/g" /conf/postgresql.conf

find /pgdata -mindepth 1 -delete

PGPASSWORD="$PG_REPL_PASSWORD" /usr/pgsql-17/bin/psql \
  -h "$PG_PRIMARY_HOST" -p "$PG_PRIMARY_PORT" -U "$PG_REPL_USER_NAME" -d postgres \
  -tAc "SELECT pg_drop_replication_slot('repl_replica') WHERE EXISTS (SELECT 1 FROM pg_replication_slots WHERE slot_name = 'repl_replica');" \
  >/dev/null 2>&1 || true


PGPASSWORD="$PG_REPL_PASSWORD" /usr/pgsql-17/bin/pg_basebackup \
  -h "$PG_PRIMARY_HOST" -p "$PG_PRIMARY_PORT" \
  -U "$PG_REPL_USER_NAME" -D /pgdata -X stream -R -S repl_replica -C -c fast -P \
  || { echo "pg_basebackup failed"; exit 1; }


{
  while IFS= read -r line; do
    if [[ "$line" == primary_conninfo* ]] && [[ "$line" != *password=* ]]; then
      line="${line%\'} password=${PG_REPL_PASSWORD}'"
    fi
    printf '%s\n' "$line"
  done
} < /pgdata/postgresql.auto.conf > /pgdata/postgresql.auto.conf.tmp
mv /pgdata/postgresql.auto.conf.tmp /pgdata/postgresql.auto.conf
chmod 600 /pgdata/postgresql.auto.conf

cp /conf/postgresql.conf /pgdata/
cp /conf/pg_hba.conf /pgdata/


cat >> /pgdata/postgresql.conf <<'EOF'

# Standby specific settings
port = 5432
hot_standby = on
log_filename = 'logfile_replica'
EOF

touch /pgdata/standby.signal


/usr/pgsql-17/bin/pg_ctl -D /pgdata/ -l /pglog/logfile_replica start
for i in {1..10}; do
  /usr/pgsql-17/bin/pg_isready -h localhost -p 5432 >/dev/null 2>&1 && break
  sleep 1
done
PGPASSWORD="$PG_REPL_PASSWORD" /usr/pgsql-17/bin/psql \
  -h localhost -p 5432 -U "$PG_REPL_USER_NAME" -d postgres \
  -c "SELECT pg_create_physical_replication_slot('repl_replica') WHERE NOT EXISTS (SELECT 1 FROM pg_replication_slots WHERE slot_name = 'repl_replica');"
/usr/pgsql-17/bin/pg_ctl -D /pgdata/ stop

exec /usr/pgsql-17/bin/postgres -D /pgdata/ "$@"